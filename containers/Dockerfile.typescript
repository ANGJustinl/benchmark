FROM python:3.12.14-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
COPY --chmod=0755 tools/node_modules/node/bin/node /usr/local/bin/node
COPY --chmod=0755 tools/node_modules/typescript /opt/typescript
RUN ln -s /opt/typescript/bin/tsc /usr/local/bin/tsc
USER 65534:65534
WORKDIR /src
